# Copy this file to .env and fill in your values.

# Session secret — used to sign auth cookies.
# Generate a new one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-this-to-a-random-64-char-hex-string

# Optional — path to the SQLite file. Only needed in Docker, where it should
# point at the mounted volume (see docker-compose.yml). Defaults to
# ./calendar.db for local dev.
# DATABASE_PATH=/app/data/calendar.db

# Only needed in Docker (see docker-compose.yml's cloudflare-ddns service).
# Create at dash.cloudflare.com -> My Profile -> API Tokens -> Create Token,
# using the "Edit zone DNS" template scoped to just the geodesync.com zone.
# CLOUDFLARE_API_TOKEN=

# Only needed in Docker. Absolute path on the HOST where database backups are
# written (see the Backups section of the README). Must be outside the calendar
# folder, and writable by whichever user the container's writes land as — your
# own user under Docker Desktop, or uid 1001 on a plain Linux host. Creating it
# is usually all that's needed:
#   mkdir -p ~/calendar-backups
# Compose does not expand "~", so write the path out in full.
# BACKUP_HOST_DIR=/home/your-user/calendar-backups
