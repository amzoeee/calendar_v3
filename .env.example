# Copy this file to .env and fill in your values.

# Session secret — used to sign auth cookies.
# Generate a new one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-this-to-a-random-64-char-hex-string

# Optional — path to the SQLite file. Only needed in Docker, where it should
# point at the mounted volume (see docker-compose.yml). Defaults to
# ./calendar.db for local dev.
# DATABASE_PATH=/app/data/calendar.db
